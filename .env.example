# Postgres connection. Local dev example:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/budget_tool
# Set false to force-disable SSL (auto: off for localhost, on otherwise)
# PGSSL=false
# Shared app password (same model as SP Tracker)
APP_PASSWORD=northdakota
SESSION_SECRET=change-me
# Comma-separated admin usernames (loose match, letters only)
ADMIN_USERS=Troy Steiss
PORT=3100
# Second gate on the Payroll tab (per-seat pay lives behind it) — set a REAL
# password in production, different from APP_PASSWORD
PAYROLL_PASSWORD=payroll
# Who may see Regional-Manager pay (Troy 2026-10-28: these two only)
RM_PAY_USERS=Troy Steiss,Riley Combs
